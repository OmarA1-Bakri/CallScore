[Unit]
Description=Crypto Tuber Ranked Hermes worker
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/crypto-tuber-ranked
RemainAfterExit=yes
ExecStart=/usr/bin/docker compose -p crypto-tuber-ranked up -d --no-deps hermes-worker
ExecStop=/usr/bin/docker compose -p crypto-tuber-ranked stop hermes-worker
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
