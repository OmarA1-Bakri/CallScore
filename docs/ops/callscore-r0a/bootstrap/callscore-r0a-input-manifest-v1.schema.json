{
  "$id": "https://call-score.com/schemas/callscore-r0a-input-manifest-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "application_base",
    "workplane_base",
    "hermes",
    "plan",
    "prompt",
    "review_inputs",
    "mutable_inputs"
  ],
  "properties": {
    "schema": { "const": "callscore.r0a_input_manifest.v1" },
    "application_base": { "$ref": "#/$defs/gitTuple" },
    "workplane_base": { "$ref": "#/$defs/gitTuple" },
    "hermes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "anchor_files"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "anchor_files": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "$ref": "#/$defs/hermesGatewayStatus" },
            { "$ref": "#/$defs/hermesState" },
            { "$ref": "#/$defs/hermesSessionSearch" }
          ],
          "items": false
        }
      }
    },
    "plan": { "$ref": "#/$defs/plan" },
    "prompt": { "$ref": "#/$defs/prompt" },
    "review_inputs": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        { "$ref": "#/$defs/reviewTimeout" },
        { "$ref": "#/$defs/reviewSecurityFail" },
        { "$ref": "#/$defs/reviewSpecificationFail" },
        { "$ref": "#/$defs/reviewSecurityFail2" },
        { "$ref": "#/$defs/reviewSpecificationFail2" },
        { "$ref": "#/$defs/reviewImplementationFail" }
      ],
      "items": false
    },
    "mutable_inputs": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "$ref": "#/$defs/mutableSnapshotService" },
        { "$ref": "#/$defs/mutableSnapshotTimer" },
        { "$ref": "#/$defs/mutableGatewayService" },
        { "$ref": "#/$defs/mutableSnapshotScript" }
      ],
      "items": false
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "printableAbsolutePath": { "type": "string", "pattern": "^/[^\\u0000-\\u001F\\u007F]*$" },
    "gitTuple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "hashPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/printableAbsolutePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "plan": {
      "allOf": [
        { "$ref": "#/$defs/hashPath" },
        { "properties": { "path": { "const": "/opt/crypto-tuber-ranked/docs/plans/2026-07-30-callscore-full-system-recovery-and-activation.md" } } }
      ]
    },
    "prompt": {
      "allOf": [
        { "$ref": "#/$defs/hashPath" },
        { "properties": { "path": { "const": "/opt/crypto-tuber-ranked/docs/prompts/2026-07-30-callscore-r0a-maintenance-preparation-prompt.md" } } }
      ]
    },
    "hermesGatewayStatus": {
      "allOf": [
        { "$ref": "#/$defs/hashPath" },
        { "properties": { "path": { "const": "/srv/agents/hermes/hermes-agent/gateway/status.py" } } }
      ]
    },
    "hermesState": {
      "allOf": [
        { "$ref": "#/$defs/hashPath" },
        { "properties": { "path": { "const": "/srv/agents/hermes/hermes-agent/hermes_state.py" } } }
      ]
    },
    "hermesSessionSearch": {
      "allOf": [
        { "$ref": "#/$defs/hashPath" },
        { "properties": { "path": { "const": "/srv/agents/hermes/hermes-agent/tools/session_search_tool.py" } } }
      ]
    },
    "reviewTimeout": {
      "allOf": [
        { "$ref": "#/$defs/hashPath" },
        { "properties": { "path": { "const": "/opt/crypto-tuber-ranked/docs/ops/callscore-r0a/input-reviews/deleg_1fb6fe24-implementation-timeout.json" } } }
      ]
    },
    "reviewSecurityFail": {
      "allOf": [
        { "$ref": "#/$defs/hashPath" },
        { "properties": { "path": { "const": "/opt/crypto-tuber-ranked/docs/ops/callscore-r0a/input-reviews/deleg_1fb6fe24-security-fail.md" } } }
      ]
    },
    "reviewSpecificationFail": {
      "allOf": [
        { "$ref": "#/$defs/hashPath" },
        { "properties": { "path": { "const": "/opt/crypto-tuber-ranked/docs/ops/callscore-r0a/input-reviews/deleg_1fb6fe24-specification-fail.md" } } }
      ]
    },
    "reviewSecurityFail2": {
      "allOf": [
        { "$ref": "#/$defs/hashPath" },
        { "properties": { "path": { "const": "/opt/crypto-tuber-ranked/docs/ops/callscore-r0a/input-reviews/deleg_a7901f50-r0a-security-fail.md" } } }
      ]
    },
    "reviewSpecificationFail2": {
      "allOf": [
        { "$ref": "#/$defs/hashPath" },
        { "properties": { "path": { "const": "/opt/crypto-tuber-ranked/docs/ops/callscore-r0a/input-reviews/deleg_c26083f7-r0a-specification-fail.md" } } }
      ]
    },
    "reviewImplementationFail": {
      "allOf": [
        { "$ref": "#/$defs/hashPath" },
        { "properties": { "path": { "const": "/opt/crypto-tuber-ranked/docs/ops/callscore-r0a/input-reviews/deleg_e17283dc-r0a-implementation-fail.md" } } }
      ]
    },
    "mutableInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "capture_path", "sha256", "device_inode", "mode", "uid", "gid"],
      "properties": {
        "path": { "$ref": "#/$defs/printableAbsolutePath" },
        "capture_path": { "$ref": "#/$defs/printableAbsolutePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "device_inode": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" },
        "mode": { "type": "string", "pattern": "^[0-7]{4}$" },
        "uid": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "gid": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "mutableSnapshotService": {
      "allOf": [
        { "$ref": "#/$defs/mutableInput" },
        { "properties": {
          "path": { "const": "/etc/systemd/system/agent-snapshot.service" },
          "capture_path": { "type": "string", "pattern": "^/srv/agents/worktrees/\\.r0a-input-captures-[a-z0-9][a-z0-9-]{7,63}/agent-snapshot\\.service$" }
        } }
      ]
    },
    "mutableSnapshotTimer": {
      "allOf": [
        { "$ref": "#/$defs/mutableInput" },
        { "properties": {
          "path": { "const": "/etc/systemd/system/agent-snapshot.timer" },
          "capture_path": { "type": "string", "pattern": "^/srv/agents/worktrees/\\.r0a-input-captures-[a-z0-9][a-z0-9-]{7,63}/agent-snapshot\\.timer$" }
        } }
      ]
    },
    "mutableGatewayService": {
      "allOf": [
        { "$ref": "#/$defs/mutableInput" },
        { "properties": {
          "path": { "const": "/home/omar/.config/systemd/user/hermes-callscore-gateway.service" },
          "capture_path": { "type": "string", "pattern": "^/srv/agents/worktrees/\\.r0a-input-captures-[a-z0-9][a-z0-9-]{7,63}/hermes-callscore-gateway\\.service$" }
        } }
      ]
    },
    "mutableSnapshotScript": {
      "allOf": [
        { "$ref": "#/$defs/mutableInput" },
        { "properties": {
          "path": { "const": "/usr/local/bin/agent-snapshot" },
          "capture_path": { "type": "string", "pattern": "^/srv/agents/worktrees/\\.r0a-input-captures-[a-z0-9][a-z0-9-]{7,63}/agent-snapshot$" }
        } }
      ]
    }
  }
}
