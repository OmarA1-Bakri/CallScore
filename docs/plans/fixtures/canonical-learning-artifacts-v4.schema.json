{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://call-score.com/schemas/canonical-learning-artifacts.v4.json",
  "title": "Canonical CallScore learning artifact bundle",
  "oneOf": [
    { "$ref": "#/$defs/learningEvent" },
    { "$ref": "#/$defs/agentPerformanceLedger" },
    { "$ref": "#/$defs/learningDelta" },
    { "$ref": "#/$defs/experimentResult" }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "nullableUuid": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
    "provenance": {
      "type": "object",
      "required": [
        "workflow_id", "measurement_id", "generation_id", "publication_id",
        "agent_id", "channel", "prompt_name", "prompt_version", "prompt_sha256",
        "model", "provider", "parameters", "evaluator_weighted_score",
        "experiment_id", "cohort_id", "variant_id", "source_artifact_id",
        "source_sha256", "registry_version", "recorded_at"
      ],
      "properties": {
        "workflow_id": { "$ref": "#/$defs/uuid" },
        "measurement_id": { "$ref": "#/$defs/uuid" },
        "generation_id": { "$ref": "#/$defs/uuid" },
        "publication_id": { "type": ["string", "null"], "minLength": 1 },
        "agent_id": { "type": "string", "minLength": 1 },
        "channel": { "type": "string", "minLength": 1 },
        "prompt_name": { "type": "string", "minLength": 1 },
        "prompt_version": { "type": "string", "minLength": 1 },
        "prompt_sha256": { "$ref": "#/$defs/sha256" },
        "model": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "parameters": { "type": "object" },
        "evaluator_weighted_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "experiment_id": { "$ref": "#/$defs/nullableUuid" },
        "cohort_id": { "$ref": "#/$defs/nullableUuid" },
        "variant_id": { "$ref": "#/$defs/nullableUuid" },
        "source_artifact_id": { "$ref": "#/$defs/uuid" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "registry_version": { "type": "integer", "minimum": 1 },
        "recorded_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "learningEvent": {
      "allOf": [
        { "$ref": "#/$defs/provenance" },
        {
          "type": "object",
          "required": ["schema", "event_type", "metric_name", "metric_value", "attribution_contract"],
          "properties": {
            "schema": { "const": "learning_event.v1" },
            "event_type": { "enum": ["quality_observation", "outcome_observation", "safety_observation", "safety_violation", "policy_violation", "canonical_receipt_violation", "public_deletion_violation", "restricted_lane_violation"] },
            "metric_name": { "type": "string", "minLength": 1 },
            "metric_value": { "type": "number" },
            "attribution_contract": { "type": "object", "minProperties": 1 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "agentPerformanceLedger": {
      "allOf": [
        { "$ref": "#/$defs/provenance" },
        {
          "type": "object",
          "required": ["schema", "period_started_at", "period_duration_seconds", "task_counts", "quality_metrics", "outcome_metrics", "safety_violations"],
          "properties": {
            "schema": { "const": "agent_performance_ledger.v1" },
            "period_started_at": { "$ref": "#/$defs/timestamp" },
            "period_duration_seconds": { "type": "integer", "minimum": 1 },
            "task_counts": {
              "type": "object",
              "additionalProperties": false,
              "required": ["completed", "failed", "remaining"],
              "properties": {
                "completed": { "type": "integer", "minimum": 0 },
                "failed": { "type": "integer", "minimum": 0 },
                "remaining": { "type": "integer", "minimum": 0 }
              }
            },
            "quality_metrics": { "type": "object", "minProperties": 1 },
            "outcome_metrics": { "type": "object", "minProperties": 1 },
            "safety_violations": { "type": "integer", "minimum": 0 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "learningDelta": {
      "allOf": [
        { "$ref": "#/$defs/provenance" },
        {
          "type": "object",
          "required": ["schema", "prior_variant_id", "candidate_variant_id", "changes", "evidence_artifact_ids", "hypothesis", "predicted_effect", "risk_class"],
          "properties": {
            "schema": { "const": "learning_delta.v1" },
            "prior_variant_id": { "$ref": "#/$defs/uuid" },
            "candidate_variant_id": { "$ref": "#/$defs/uuid" },
            "changes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["field", "before_sha256", "after_sha256", "controlled_reason_code"],
                "properties": {
                  "field": { "enum": ["prompt", "parameters", "tools_manifest", "skills_manifest"] },
                  "before_sha256": { "$ref": "#/$defs/sha256" },
                  "after_sha256": { "$ref": "#/$defs/sha256" },
                  "controlled_reason_code": { "type": "string", "minLength": 1 }
                }
              }
            },
            "evidence_artifact_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/uuid" }, "uniqueItems": true },
            "hypothesis": { "type": "string", "minLength": 1 },
            "predicted_effect": { "type": "number" },
            "risk_class": { "enum": ["LOW", "MEDIUM", "HIGH"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "experimentResult": {
      "allOf": [
        { "$ref": "#/$defs/provenance" },
        {
          "type": "object",
          "required": ["schema", "variant_ids", "control_sample_size", "treatment_sample_size", "observation_days", "primary_metric", "absolute_delta", "relative_delta", "bootstrap_ci95", "safety_violations", "decision"],
          "properties": {
            "schema": { "const": "experiment_result.v1" },
            "variant_ids": {
              "type": "array",
              "prefixItems": [{ "$ref": "#/$defs/uuid" }, { "$ref": "#/$defs/uuid" }],
              "items": false,
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true
            },
            "control_sample_size": { "type": "integer", "minimum": 0 },
            "treatment_sample_size": { "type": "integer", "minimum": 0 },
            "observation_days": { "type": "integer", "minimum": 0 },
            "primary_metric": { "type": "string", "minLength": 1 },
            "absolute_delta": { "type": "number" },
            "relative_delta": { "type": "number" },
            "bootstrap_ci95": {
              "type": "object",
              "additionalProperties": false,
              "required": ["lower", "width", "resamples", "seed"],
              "properties": {
                "lower": { "type": "number" },
                "width": { "type": "number", "minimum": 0 },
                "resamples": { "type": "integer", "minimum": 1000 },
                "seed": { "type": "integer" }
              }
            },
            "safety_violations": { "type": "integer", "minimum": 0 },
            "decision": { "enum": ["PROMOTE", "REJECT", "ROLLBACK", "CONTINUE"] }
          },
          "allOf": [
            {
              "if": { "properties": { "decision": { "const": "PROMOTE" } }, "required": ["decision"] },
              "then": { "properties": {
                "control_sample_size": { "minimum": 30 },
                "treatment_sample_size": { "minimum": 30 },
                "observation_days": { "minimum": 14 },
                "relative_delta": { "minimum": 0.1 },
                "bootstrap_ci95": { "properties": { "lower": { "minimum": 0 }, "resamples": { "const": 10000 } } },
                "safety_violations": { "const": 0 }
              } }
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
