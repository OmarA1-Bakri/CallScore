FROM node:22-bookworm-slim AS hermes-worker

ARG YTDLP_VERSION=2026.6.9
ARG YTDLP_EJS_VERSION=0.8.0
ARG YTDLP_BGUTIL_POT_PROVIDER_VERSION=1.3.1
ARG YTDLP_GETPOT_WPC_VERSION=1.0.0

USER root
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates chromium python3 python3-venv \
  && python3 -m venv "/opt/callscore/yt-dlp-${YTDLP_VERSION}" \
  && "/opt/callscore/yt-dlp-${YTDLP_VERSION}/bin/pip" install --no-cache-dir \
    "yt-dlp==${YTDLP_VERSION}" \
    "yt-dlp-ejs==${YTDLP_EJS_VERSION}" \
    "bgutil-ytdlp-pot-provider==${YTDLP_BGUTIL_POT_PROVIDER_VERSION}" \
    "yt-dlp-getpot-wpc==${YTDLP_GETPOT_WPC_VERSION}" \
  && "/opt/callscore/yt-dlp-${YTDLP_VERSION}/bin/yt-dlp" --version \
  && "/opt/callscore/yt-dlp-${YTDLP_VERSION}/bin/python" -c "import yt_dlp_ejs; print('yt_dlp_ejs=ok')" \
  && "/opt/callscore/yt-dlp-${YTDLP_VERSION}/bin/python" -c "import yt_dlp_plugins.extractor.getpot_bgutil_http; print('bgutil_ytdlp_pot_provider=ok')" \
  && "/opt/callscore/yt-dlp-${YTDLP_VERSION}/bin/python" -c "import yt_dlp_plugins.extractor.getpot_wpc; print('yt_dlp_getpot_wpc=ok')" \
  && touch "/opt/callscore/yt-dlp-${YTDLP_VERSION}/.callscore-yt-dlp-ejs-${YTDLP_EJS_VERSION}" \
  && chmod 0444 "/opt/callscore/yt-dlp-${YTDLP_VERSION}/.callscore-yt-dlp-ejs-${YTDLP_EJS_VERSION}" \
  && chromium --version \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN chown node:node /app
USER node

COPY --chown=node:node package.json package-lock.json ./
RUN npm ci

COPY --chown=node:node . .

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

CMD ["npm", "run", "pipeline:worker"]
